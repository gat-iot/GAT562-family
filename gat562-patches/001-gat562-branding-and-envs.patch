+  -DHAS_NEOPIXEL=1 ; P1.01
+  -DNEOPIXEL_DATA=29 ; P0.29
+  -DTB_DIRECTION=FALLING
+  -DSX126X_MAX_POWER=19 ; maxrf
+lib_deps =
